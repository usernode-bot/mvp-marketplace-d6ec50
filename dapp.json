{
  "description": "A modern mobile-first marketplace: deals, categories and everyday essentials.",
  "icon": { "image": "brand/icon.png" },
  "permissions": [
    { "capability": "geolocation", "reason": "Find products shipping from a city near you" }
  ],
  "secrets": [],
  "tests": [
    {
      "id": "home.filters-toolbar",
      "name": "Home Recommended grid renders the filter and sort toolbar",
      "path": "/",
      "expectSelector": "#section-recommended [data-filter-toolbar] [data-filter-open]",
      "expectText": "Filters",
      "visual": true,
      "impact": ["public/js/filter-ui.js", "public/js/filters.js", "public/js/home.js", "public/js/ui.js", "public/js/router.js", "public/index.html", "styles/tailwind-input.css", "src/products.cjs", "server.js"]
    },
    {
      "id": "home.filter-city",
      "name": "Filtering the home grid by city keeps only that city's products",
      "path": "/#/home?city=Batam",
      "expectSelector": "#recommended-chips [data-result-count]",
      "expectText": "products"
    },
    {
      "id": "home.filter-cities-multi",
      "name": "Selecting two cities keeps products from both",
      "path": "/#/home?city=Bandung,Bekasi",
      "expectSelector": "#recommended-chips [data-result-count]",
      "expectText": "14 products"
    },
    {
      "id": "home.filter-city-card",
      "name": "A filtered product card shows the city it ships from",
      "path": "/#/home?city=Batam",
      "expectSelector": "#recommended-grid [data-card-city]"
    },
    {
      "id": "home.filter-sort-price",
      "name": "Home grid applies a price range and sort from the URL",
      "path": "/#/home?sort=price_asc&min=100&max=200",
      "expectSelector": "[data-chip-remove='price']",
      "expectText": "Price: Low to High"
    },
    {
      "id": "home.filter-empty",
      "name": "A city with no products shows the empty state",
      "path": "/#/home?city=Nowhere",
      "expectText": "No products found."
    },
    {
      "id": "home.filter-province-chip",
      "name": "A province filter renders a removable location chip",
      "path": "/#/home?province=Bali",
      "expectSelector": "[data-chip-remove='location']",
      "expectText": "Bali"
    },
    {
      "id": "home.default",
      "name": "Home renders with banners, categories, flash sale and products",
      "path": "/",
      "expectSelector": "[data-view='home'] .product-card",
      "expectText": "Flash Sale",
      "visual": true,
      "impact": ["public/**", "styles/tailwind-input.css", "tailwind.config.js"]
    },
    {
      "id": "theme.swatches",
      "name": "Header theme swatches render with all five color themes",
      "path": "/",
      "expectSelector": "#theme-swatches button[data-theme-swatch='midnight']"
    },
    {
      "id": "theme.profile-swatches",
      "name": "Profile page renders the mobile color theme row",
      "path": "/#/profile",
      "expectSelector": "[data-theme-swatch='ocean']"
    },
    {
      "id": "home.grid-new-cards",
      "name": "Recommended grid leads with the expanded catalog and its add buttons",
      "path": "/",
      "expectSelector": "[data-product='r001'] .add-btn",
      "expectText": "Nova Laptop 14\""
    },
    {
      "id": "home.recommended-photo",
      "name": "A Recommended card shows a real product photo",
      "path": "/",
      "expectSelector": "[data-product='r001'] img[data-product-image]",
      "expectText": "Nova Laptop 14\""
    },
    {
      "id": "home.flash-photo",
      "name": "Flash Sale cards show real product photos",
      "path": "/",
      "expectSelector": "#flash-row .product-card img[data-product-image]",
      "expectText": "Flash Sale"
    },
    {
      "id": "home.browse-photo",
      "name": "Category browse cards show real product photos",
      "path": "/#/category/electronics",
      "expectSelector": "#view-browse .product-card img[data-product-image]"
    },
    {
      "id": "home.grid-rich-art",
      "name": "Previously placeholder products still render rich illustrations",
      "path": "/#/category/electronics",
      "expectSelector": "[data-product='p03'] svg.product-img[data-art='rich']",
      "expectText": "Klarita 4K Action Camera"
    },
    {
      "id": "home.sold-out-art",
      "name": "Sold out product keeps its badge and renders rich art",
      "path": "/#/category/electronics",
      "expectSelector": "[data-product='p04'] svg.product-img[data-art='rich']",
      "expectText": "Sold out"
    },
    {
      "id": "home.recommended-load-more",
      "name": "Recommended grid paginates with a Load more button",
      "path": "/",
      "expectSelector": "#recommended-more-btn",
      "expectText": "Load more"
    },
    {
      "id": "home.recommended-sold-out",
      "name": "A sold out recommendation shows the disabled add button",
      "path": "/",
      "expectSelector": "[data-product='r007'] .add-btn[disabled]",
      "expectText": "Sold out"
    },
    {
      "id": "home.recommended-no-discount",
      "name": "A full-price recommendation renders without a sale badge",
      "path": "/",
      "expectSelector": "[data-product='r004']:not(:has(.badge-sale)) .add-btn",
      "expectText": "Orbit Laptop 14\""
    },
    {
      "id": "product.smarthome-hub",
      "name": "Smart Home Hub product page renders with price and discount",
      "path": "/#/product/p44",
      "expectSelector": "#view-product .add-btn",
      "expectText": "$119.99"
    },
    {
      "id": "product.detail-image",
      "name": "Product detail gallery shows the product's real photo",
      "path": "/#/product/r001",
      "expectSelector": "#view-product #pdp-img img[data-gallery-img][src*='notebook-1.jpg']"
    },
    {
      "id": "product.image-matches-card",
      "name": "Detail main image matches the card photo for the same product",
      "path": "/#/product/p09",
      "expectSelector": "#view-product #pdp-img img[data-gallery-img][src*='tee-1.jpg']",
      "visual": true,
      "impact": ["public/js/product.js", "public/js/data.js", "public/js/ui.js"]
    },
    {
      "id": "product.gallery-thumbnails",
      "name": "Detail gallery renders thumbnails for a multi-photo product",
      "path": "/#/product/p05",
      "expectSelector": "#view-product [data-img-go][aria-label^='Show photo 2']"
    },
    {
      "id": "product.specs",
      "name": "Detail page renders the Specifications table with identity rows",
      "path": "/#/product/r001",
      "expectSelector": "#view-product dl",
      "expectText": "Specifications"
    },
    {
      "id": "product.specs-rows",
      "name": "Specifications renders the category-shaped rows for another product",
      "path": "/#/product/p26",
      "expectText": "Power / Capacity"
    },
    {
      "id": "product.no-glyph-gallery",
      "name": "Detail gallery shows a photo rather than the generated glyph",
      "path": "/#/product/p12",
      "expectSelector": "#view-product #pdp-img img[data-gallery-img][src*='sunglasses-6.jpg']"
    },
    {
      "id": "home.flash-images",
      "name": "Flash Sale cards show detailed product illustrations",
      "path": "/",
      "expectSelector": "#flash-row .product-card svg.product-img",
      "expectText": "Flash Sale"
    },
    {
      "id": "home.flash-nav",
      "name": "Flash Sale row has an accessible right scroll arrow",
      "path": "/",
      "expectSelector": "#flash-next[aria-label=\"Scroll right\"]",
      "expectText": "Flash Sale"
    },
    {
      "id": "home.category-tiles",
      "name": "Category tiles render as icon links with navigation paths",
      "path": "/",
      "expectSelector": "#category-grid a[href='#/category/electronics'] svg",
      "expectText": "Accessories"
    },
    {
      "id": "home.categories-tab",
      "name": "Categories tab renders category tiles",
      "path": "/#/categories",
      "expectText": "All categories"
    },
    {
      "id": "home.cart-empty",
      "name": "Cart tab shows the empty state",
      "path": "/#/cart",
      "expectText": "Your cart is empty"
    },
    {
      "id": "browse.category",
      "name": "Category page renders subcategories, toolbar and product grid",
      "path": "/#/category/electronics",
      "expectSelector": "#view-browse .product-card",
      "expectText": "Sort:",
      "visual": true,
      "impact": ["public/js/browse.js", "public/js/router.js", "public/js/data.js", "public/index.html"]
    },
    {
      "id": "browse.search-results",
      "name": "Search results render the query and matching products",
      "path": "/#/search?q=headphones",
      "expectSelector": "#view-browse .product-card",
      "expectText": "Results for"
    },
    {
      "id": "browse.search-empty",
      "name": "Search with no matches shows the empty state",
      "path": "/#/search?q=zzzznothing",
      "expectText": "No results found"
    },
    {
      "id": "browse.search-brand",
      "name": "Search empty state names the MVP Marketplace brand",
      "path": "/#/search",
      "expectText": "Search MVP Marketplace"
    },
    {
      "id": "product.detail",
      "name": "Product page renders gallery, variants, reviews and buy bar",
      "path": "/#/product/p01",
      "expectSelector": "#view-product .add-btn",
      "expectText": "Add to Cart",
      "visual": true,
      "impact": ["public/js/product.js", "public/js/router.js", "public/js/data.js", "public/js/store.js", "public/index.html"]
    },
    {
      "id": "checkout.default",
      "name": "Checkout renders address, products, shipping, payment and summary",
      "path": "/?demo=checkout#/checkout",
      "expectSelector": "[data-checkout-products]",
      "expectText": "Order summary",
      "visual": true,
      "impact": [
        "public/js/checkout.js",
        "public/js/shipping.js",
        "public/js/app.js",
        "public/js/store.js",
        "public/js/views.js",
        "public/js/icons.js",
        "public/js/ui.js",
        "public/index.html",
        "styles/tailwind-input.css"
      ]
    },
    {
      "id": "checkout.empty",
      "name": "Checkout with an empty cart shows the empty state",
      "path": "/#/checkout",
      "expectText": "Add items to your cart"
    },
    {
      "id": "checkout.couriers",
      "name": "Checkout offers a destination country and at least three couriers",
      "path": "/?demo=checkout#/checkout",
      "expectSelector": "[data-country-select]",
      "expectText": "Destination country"
    },
    {
      "id": "orders.detail-courier",
      "name": "Order detail names the chosen courier and destination country",
      "path": "/#/orders/BZ-48073",
      "expectText": "Ship to United States"
    },
    {
      "id": "cart.default",
      "name": "Cart renders items, selection, summary and vouchers",
      "path": "/?demo=1#/cart",
      "expectSelector": "[data-cart-row]",
      "expectText": "Order summary",
      "visual": true,
      "impact": ["public/**", "styles/tailwind-input.css", "tailwind.config.js"]
    },
    {
      "id": "cart.vouchers",
      "name": "Available vouchers are listed on the cart",
      "path": "/?demo=1#/cart",
      "expectText": "WELCOME10"
    },
    {
      "id": "orders.default",
      "name": "Orders page renders status tabs and order cards",
      "path": "/#/orders",
      "expectSelector": "[data-order-card]",
      "expectText": "To Pay",
      "visual": true,
      "impact": ["public/js/orders.js", "public/js/app.js", "public/index.html", "styles/tailwind-input.css"]
    },
    {
      "id": "orders.detail",
      "name": "Order detail shows timeline, address, payment and totals",
      "path": "/#/orders/BZ-48073",
      "expectSelector": "[data-order-timeline]",
      "expectText": "Shipping address",
      "visual": true,
      "impact": ["public/js/orders.js", "public/js/data.js"]
    },
    {
      "id": "profile.default",
      "name": "Profile page renders account header and menu",
      "path": "/#/profile",
      "expectText": "Edit Profile",
      "visual": true,
      "impact": [
        "public/js/profile.js",
        "public/js/profile-photo.js",
        "public/js/settings.js",
        "public/js/ui.js",
        "public/js/api.js",
        "public/js/icons.js",
        "public/js/app.js",
        "server.js",
        "styles/tailwind-input.css"
      ]
    },
    {
      "id": "profile.avatar-control",
      "name": "Profile avatar is tappable and carries the camera badge",
      "path": "/#/profile",
      "expectSelector": "[data-avatar-edit] [data-avatar] [data-avatar-fallback]"
    },
    {
      "id": "profile.avatar-photo-demo",
      "name": "Profile shows a stored photo as a circular avatar (staging demo)",
      "path": "/?demo=1#/profile",
      "expectSelector": "[data-avatar] [data-avatar-img]"
    },
    {
      "id": "profile.wishlist-demo",
      "name": "Wishlist shows saved products with the demo account",
      "path": "/?demo=1#/profile/wishlist",
      "expectSelector": "[data-view='profile'] .product-card",
      "expectText": "Wishlist"
    },
    {
      "id": "profile.addresses-demo",
      "name": "Address list renders with a default address",
      "path": "/?demo=1#/profile/addresses",
      "expectSelector": "[data-address-row]",
      "expectText": "Default"
    },
    {
      "id": "profile.settings",
      "name": "Settings renders notification, preference and privacy groups",
      "path": "/#/profile/settings",
      "expectText": "Notification settings"
    },
    {
      "id": "profile.payment-default",
      "name": "Payment methods page lists grouped methods with a default badge",
      "path": "/?demo=1#/profile/payment",
      "expectSelector": "[data-pay-row='bca'] .badge-brand",
      "expectText": "Bank Transfer / Virtual Account",
      "visual": true,
      "impact": [
        "public/js/payment.js",
        "public/js/profile.js",
        "public/js/store.js",
        "public/js/app.js",
        "public/js/checkout.js",
        "public/index.html"
      ]
    },
    {
      "id": "profile.payment-empty",
      "name": "Payment methods page shows the empty state when nothing is saved",
      "path": "/#/profile/payment",
      "expectText": "No payment methods saved"
    },
    {
      "id": "checkout.default-payment",
      "name": "Checkout preselects the saved default payment method",
      "path": "/?demo=checkout#/checkout",
      "expectText": "BCA"
    },
    {
      "id": "home.search-quoted",
      "name": "Search query with quotes and angle brackets renders as text",
      "path": "/?q=wireless%20%22pro%22%20%3Ctest%3E",
      "expectText": "Nothing matches \"wireless \"pro\" <test>\" right now"
    },
    {
      "id": "product.reviews-photos",
      "name": "A product's reviews render with real photos and the verified-purchase badge",
      "path": "/#/product/p09",
      "expectSelector": "#pdp-reviews [data-review-photo]",
      "expectText": "Verified purchase",
      "visual": true,
      "impact": ["public/js/reviews.js", "public/js/product.js", "public/index.html", "styles/tailwind-input.css", "server.js"]
    },
    {
      "id": "product.reviews-empty",
      "name": "A product with no reviews shows the empty state",
      "path": "/#/product/p27",
      "expectText": "No reviews yet."
    },
    {
      "id": "product.review-composer",
      "name": "The reviews section offers the reviewer action for the signed-in viewer",
      "path": "/#/product/p09",
      "expectSelector": "#pdp-reviews [data-review-cta]"
    },
    {
      "id": "product.reviews-live",
      "name": "The reviews section opens its live-updates stream",
      "path": "/#/product/p09",
      "expectSelector": "[data-reviews-live]"
    },
    {
      "id": "orders.server-mirror",
      "name": "Checkout still renders and can place an order after the order mirror",
      "path": "/?demo=checkout#/checkout",
      "expectSelector": "[data-place-order]",
      "expectText": "Order summary"
    }
  ]
}
